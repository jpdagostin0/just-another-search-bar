<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.just-another-search-bar"
            path="/org/gnome/shell/extensions/just-another-search-bar/">
        <key type="as" name="open-search-bar-key">
            <default><![CDATA[['<Alt>p']]]></default>
            <summary>Shortcut that opens the launcher</summary>
        </key>
        <key type="b" name="hide-workspace-popup">
            <default>true</default>
            <summary>Hide the workspace switcher popup</summary>
            <description>Suppress the indicator shown at the bottom of the screen when switching workspaces.</description>
        </key>
    </schema>
</schemalist>
